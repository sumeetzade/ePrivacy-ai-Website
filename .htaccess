# Apache: keep credentials and dependency files private
<FilesMatch "^(config\.php|config\.example\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
Options -Indexes -MultiViews
DirectoryIndex index.html

# Clean URLs: show /about instead of /about.html
<IfModule mod_rewrite.c>
RewriteEngine On

# Old platform pages are now sections of /platform
RewriteRule ^deployment(\.html)?$ /pricing#deployment [R=301,L,NE]
RewriteRule ^platform-architecture(\.html)?$ /platform#architecture [R=301,L,NE]
RewriteRule ^platform-models(\.html)?$ /platform#models [R=301,L,NE]
RewriteRule ^platform-guardrails(\.html)?$ /platform#guardrails [R=301,L,NE]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# /page.html -> /page (301 so old links and search results keep working)
RewriteCond %{THE_REQUEST} \s/([^\s?]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L,NE]

# /page -> page.html (served internally, URL stays clean)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
